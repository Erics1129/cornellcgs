# Copy to .env.local (git-ignored) and fill in. Every value here is a PUBLIC
# identifier that ends up in the built site; none is a secret. Secrets (the
# Worker's SESSION_SECRET) live only in the Cloudflare dashboard.

# Forge or Fold world board: the Worker URL from docs/forge/BACKEND-SETUP.md.
VITE_FORGE_API_URL=

# Player accounts (progress that follows a Google sign-in): both must be set or
# the sign-in control stays hidden. See docs/accounts/SETUP.md.
VITE_ACCOUNT_API_URL=
VITE_GOOGLE_CLIENT_ID=

# Carrot Defense two-player modes (duo boss fights, two-player endless): the cgs-rooms Worker URL
# from backend/rooms/README.md. Empty keeps multiplayer hidden and the site exactly as before.
VITE_ROOMS_URL=
