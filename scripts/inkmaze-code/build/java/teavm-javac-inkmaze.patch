diff -ruN a/compiler/src/main/java/org/teavm/javac/WasmBodyPatch.java b/compiler/src/main/java/org/teavm/javac/WasmBodyPatch.java
--- a/compiler/src/main/java/org/teavm/javac/WasmBodyPatch.java
+++ b/compiler/src/main/java/org/teavm/javac/WasmBodyPatch.java
@@ -0,0 +1,41 @@
+/*
+ *  Ink Maze level 26 (Cornell CGS site): a fix for TeaVM 0.13.1's WebAssembly GC backend.
+ *
+ *  A method that can never return (a loop with no exit: javac accepts it)
+ *  compiled to a function body that ends without its result, which every
+ *  engine rejects ("expected 1 elements on the stack for fallthru"). Patches
+ *  calls finish() right after WasmGCMethodGenerator has generated a method
+ *  body. When a non-void body ends with a statement that leaves no value (a
+ *  loop, a block, a try, an if), its end is never reached in valid Java
+ *  (javac checked that every path returns or throws), so finish() says so
+ *  with `unreachable`. A body that ends with its result value is left alone.
+ *
+ *  Licensed under the Apache License, Version 2.0, like the rest of teavm-javac.
+ */
+package org.teavm.javac;
+
+import java.util.List;
+import org.teavm.backend.wasm.model.WasmFunction;
+import org.teavm.backend.wasm.model.expression.WasmBlock;
+import org.teavm.backend.wasm.model.expression.WasmConditional;
+import org.teavm.backend.wasm.model.expression.WasmExpression;
+import org.teavm.backend.wasm.model.expression.WasmTry;
+import org.teavm.backend.wasm.model.expression.WasmUnreachable;
+
+public final class WasmBodyPatch {
+    private WasmBodyPatch() {
+    }
+
+    public static void finish(WasmFunction function, List<WasmExpression> target) {
+        if (function.getType() == null || function.getType().getSingleReturnType() == null || target.isEmpty()) {
+            return;
+        }
+        var last = target.get(target.size() - 1);
+        var noValue = (last instanceof WasmBlock block && block.getType() == null)
+                || (last instanceof WasmTry tryBlock && tryBlock.getType() == null)
+                || (last instanceof WasmConditional conditional && conditional.getType() == null);
+        if (noValue) {
+            target.add(new WasmUnreachable());
+        }
+    }
+}
