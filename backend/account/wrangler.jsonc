{
  "name": "cgs-accounts",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // GOOGLE_CLIENT_ID is a public identifier (it is also embedded in the website); SESSION_SECRET is NOT a var:
  // set it with `npx wrangler secret put SESSION_SECRET --config backend/account/wrangler.jsonc`.
  "vars": {
    "ALLOWED_ORIGIN": "https://cornellcgs.org,https://www.cornellcgs.org",
    "GOOGLE_CLIENT_ID": "REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "cgs-accounts", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }]
}
